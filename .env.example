# DataDesk - SQL Practice Platform
# Environment Variables Template
# Copy this file to .env.local and fill in your values for local development.
# For production deployment (e.g. Vercel), add these to your environment settings.

# ==========================================
# 1. Supabase (Database & Authentication)
# ==========================================
# Required for user authentication and leaderboard/progress saving.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# 2. Groq (AI Tutor)
# ==========================================
# Required for the AI Tutor panel to function.
VITE_GROQ_API_KEY=your-groq-api-key

# ==========================================
# 3. PostHog (Product Analytics) - Optional
# ==========================================
# Used for tracking user engagement and query executions.
VITE_POSTHOG_KEY=your-posthog-project-api-key
VITE_POSTHOG_HOST=https://app.posthog.com

# ==========================================
# 4. Sentry (Error Tracking) - Optional
# ==========================================
# Used for monitoring client-side crashes and performance.
VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
